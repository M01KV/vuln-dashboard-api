# Copie este arquivo para ".env" e ajuste conforme necessário.
# Nenhuma variável é obrigatória: a API funciona com os valores padrão.

# String de conexão do banco (SQLite por padrão)
DATABASE_URL=sqlite:///./vuln_dashboard.db

# Chave de API da NVD (opcional). Sem ela, o limite de requisições é menor.
# Solicite gratuitamente em: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Timeout (segundos) para chamadas à NVD
NVD_TIMEOUT_SECONDS=10

# Tempo de vida do cache local de consultas à NVD, em segundos
NVD_CACHE_TTL_SECONDS=900

# Quantidade de resultados pedidos por página à NVD
NVD_RESULTS_PER_PAGE=20

# Origens permitidas para CORS, separadas por vírgula. "*" libera todas.
CORS_ORIGINS=*

# Se definida, POST/PUT/DELETE em /ativos passam a exigir o header
# "X-API-Key" com este valor. Se deixada em branco, a proteção fica desligada.
WRITE_API_KEY=
